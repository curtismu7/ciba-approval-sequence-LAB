{
  "info": {
    "name": "CIBA Approval Sequence LAB",
    "description": "API collection for CIBA Approval Sequence LAB: the lab's read surface (talk track, approval-sequence diagram) plus the Mock/Real toggle and its unconfigured refusal. The sequence itself is rendered from data; the lab's mock lane is a labelled simulation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "90ef7dc7-6212-497a-8431-735388b7fe5e"
  },
  "item": [
    {
      "name": "Sanity (mock, labelled)",
      "description": "Health and mode info (mock by default; Real is owner-run).",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().state).to.eql('ready');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Info (mode is mock by default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Info (mode is mock by default)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  // Real settings may be configured (owner .env) \u2014 assert the shape, not a pinned mode.",
                  "  pm.expect(['mock', 'live', 'real']).to.include(pm.response.json().mode);",
                  "  pm.expect(pm.response.json()).to.have.property('realAvailable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/info",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "info"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Story data",
      "description": "The talk track and the approval-sequence diagram the page renders.",
      "item": [
        {
          "name": "Talk track",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().talk.length).to.be.above(0);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/talk-track",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "talk-track"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Approval sequence diagram",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json()).to.have.property('source');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/diagram",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "diagram"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Mode toggle",
      "description": "The Mock/Real toggle. Real needs owner-run settings (REAL_CIBA_*); without them it answers 409 with what is missing \u2014 that refusal is the negative case here.",
      "item": [
        {
          "name": "Switch to Real without settings (negative, 409 with detail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Switch to Real without settings (negative, 409 with detail)\", function () {",
                  "  // With owner settings present the switch succeeds (200); without them it 409s with detail.",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "  if (pm.response.code === 409) pm.expect(pm.response.json()).to.have.property('detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"real\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/mode",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "mode"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "LAB_BASE",
      "value": "http://localhost:7834"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Health gate (owner 2026-11-23): the lab must be up before the collection runs.",
          "// Start it with ./postman/run-collection.sh (this script cannot start docker from inside Postman).",
          "pm.sendRequest({ url: pm.collectionVariables.get('LAB_BASE') + '/api/health', method: 'GET' }, (err, res) => {",
          "  pm.test('lab is up (run ./postman/run-collection.sh to check and start it)', () => {",
          "    pm.expect(err).to.equal(null);",
          "    pm.expect(res.code).to.equal(200);",
          "  });",
          "});"
        ]
      }
    },
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Health gate (owner 2026-11-23): the lab must be up before the collection runs.",
          "// Start it with ./postman/run-collection.sh (this script cannot start docker from inside Postman).",
          "pm.sendRequest({ url: pm.collectionVariables.get('LAB_BASE') + '/api/health', method: 'GET' }, (err, res) => {",
          "  pm.test('lab is up (run ./postman/run-collection.sh to check and start it)', () => {",
          "    pm.expect(err).to.equal(null);",
          "    pm.expect(res.code).to.equal(200);",
          "  });",
          "});"
        ]
      }
    }
  ]
}

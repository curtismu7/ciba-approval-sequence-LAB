# Optional. Everything has a safe default; mock mode needs nothing.
# Real mode (owner-run only) is configured here, beside docker-compose.yml.
# When these are set, GET /api/info reports realAvailable=true and the Mock/Real
# toggle can switch to Real. Agents never use live credentials.
REAL_MODE_REQUIRED_VARS=REAL_CIBA_ENV_ID,REAL_CIBA_CLIENT_ID,REAL_CIBA_CLIENT_SECRET
# REAL_CIBA_ENV_ID=
# REAL_CIBA_CLIENT_ID=
# REAL_CIBA_CLIENT_SECRET=
# LAB_ALLOWED_HOSTS=ciba-approval-sequence-lab.local.ping-devops.com
